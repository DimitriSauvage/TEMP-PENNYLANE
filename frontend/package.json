{
  "name": "recipe-finder-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run gen:api && nuxt build",
    "generate": "npm run gen:api && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "gen:api": "orval",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "npm run gen:api && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run gen:api && playwright test",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@primevue/nuxt-module": "^4.5.5",
    "@tanstack/vue-query": "^5.102.8",
    "nuxt": "^4.5.2",
    "primeicons": "^7.0.0",
    "primevue": "^5.0.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.14.0",
    "orval": "^8.28.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
